<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8E4FF"
    tools:context=".view.AddAddressActivity">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header_add"
        android:layout_width="416dp"
        android:layout_height="108dp"
        android:background="@drawable/gradient_purple_pink"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBackAddAddress"
            android:layout_width="40dp"
            android:layout_height="50dp"
            android:src="@drawable/back_arrow"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="ADD ADDRESS"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Fake map banner -->
    <ImageView
        android:id="@+id/ivMapBanner"
        android:layout_width="412dp"
        android:layout_height="215dp"
        android:scaleType="centerCrop"
        android:src="@drawable/fake_map"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_add" />

    <!-- Set location bar -->
    <LinearLayout
        android:id="@+id/barSetLocation"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="#FFFFFFFF"
        android:gravity="center_vertical|end"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/ivMapBanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvSetLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SET LOCATION"
            android:textColor="#2E7D32"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Scrollable form -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/barSetLocation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Address title -->
            <EditText
                android:id="@+id/etAddressTitle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Address Title e.g. Home, Office *"
                android:paddingHorizontal="20dp"
                android:textSize="14sp" />

            <!-- First name -->
            <EditText
                android:id="@+id/etFirstName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:hint="First name"
                android:paddingHorizontal="20dp"
                android:textSize="14sp" />

            <!-- Last name -->
            <EditText
                android:id="@+id/etLastName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:hint="Last name"
                android:paddingHorizontal="20dp"
                android:textSize="14sp" />


            <!-- Detail address (multi-line) -->
            <EditText
                android:id="@+id/etDetailAddress"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="12dp"
                android:gravity="top|start"
                android:hint="Detail Address Direction *"
                android:paddingHorizontal="20dp"
                android:paddingTop="12dp"
                android:textSize="14sp" />

            <!-- Phone -->
            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:inputType="phone"
                android:hint="Phone number"
                android:paddingHorizontal="20dp"
                android:textSize="14sp" />



            <!-- Add button -->
            <Button
                android:id="@+id/btnSaveAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:background="@drawable/gradient_button"
                android:text="ADD"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
